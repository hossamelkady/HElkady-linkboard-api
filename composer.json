{
  "name": "hossamelkady/HElkady-linkboard-api",
  "type": "project",
  "description": "A link catalog API with slugs, destinations, and click counters.",
  "keywords": ["laravel", "php", "rest-api", "portfolio"],
  "license": "MIT",
  "require": {"php": "^8.2", "laravel/framework": "^11.0", "laravel/sanctum": "^4.0"},
  "require-dev": {"fakerphp/faker": "^1.23", "mockery/mockery": "^1.6", "phpunit/phpunit": "^11.0"},
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"test": "@php artisan test", "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable",
  "prefer-stable": true
}
